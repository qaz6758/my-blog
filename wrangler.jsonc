{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-blog",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "vinceou.site", "custom_domain": true },
    { "pattern": "www.vinceou.site", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
